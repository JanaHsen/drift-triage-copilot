# LLM provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com # Set this to the appropriate endpoint for the region you chose
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=drift-triage-copilot

# Postgres (used by both the agent's checkpoint store and the model service's predictions log)
POSTGRES_USER=project5
POSTGRES_PASSWORD=changeme
POSTGRES_DB=drift_triage_copilot
DATABASE_URL=postgresql+asyncpg://project5:changeme@postgres:5432/drift_triage_copilot

# Redis (queue for slow tools)
REDIS_URL=redis://redis:6379/0

# MLflow tracking
MLFLOW_TRACKING_URI=http://mlflow:5000

# Drift detection: how often the platform auto-checks for drift (seconds) - set to 0 to disable auto-checking - change the number to override the default of 10 minutes
DRIFT_CHECK_INTERVAL_SECONDS=600

# Bearer token shared between platform and agent.
AGENT_TOKEN=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-32

# Where the platform reaches the agent's webhook receiver locally
AGENT_BASE_URL=http://localhost:8000

# Where the agent reaches the platform's webhook receiver locally (for callbacks)
PLATFORM_BASE_URL=http://localhost:8001