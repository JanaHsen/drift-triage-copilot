# LLM provider — pick one based on what you decide for the agent
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing (Week 4 lessons referenced this — strongly recommended)
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com # Set this to the appropriate endpoint for the region you chose
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=drift-triage-copilot

# Postgres (used by both the agent's checkpoint store and the model service's predictions log)
POSTGRES_USER=project5
POSTGRES_PASSWORD=app
POSTGRES_DB=drift_triage_copilot
DATABASE_URL=postgresql+asyncpg://project5:app@postgres:5432/drift_triage_copilot

# Redis (queue for slow tools)
REDIS_URL=redis://redis:6379/0

# MLflow tracking
MLFLOW_TRACKING_URI=http://mlflow:5000