# LLM provider — pick one based on what you decide for the agent
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing (Week 4 lessons referenced this — strongly recommended)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=drift-triage-copilot

# Postgres (used by both the agent's checkpoint store and the model service's predictions log)
POSTGRES_USER=project5
POSTGRES_PASSWORD=app
POSTGRES_DB=drift_triage_copilot
DATABASE_URL=postgresql+asyncpg://project5:app@localhost:5433/drift_triage_copilot

# Redis (queue for slow tools)
REDIS_URL=redis://redis:6379/0

# MLflow tracking
MLFLOW_TRACKING_URI=http://mlflow:5000

# Bearer token shared between platform and agent.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-32

# Where the platform reaches the agent's webhook receiver.
# Inside docker-compose: http://backend:8000
# On host for local testing: http://localhost:8000
AGENT_BASE_URL=http://backend:8000